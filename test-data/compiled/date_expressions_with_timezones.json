  "tests": {
    "errors": [
      {
        "description": "Aggregate operation 1",
        "query": [
          {
            "$group": {
              "_id": {
                "year": {
                  "$year": "$date"
                },
                "month": {
                  "$month": "$date"
                },
                "day": {
                  "$dayOfMonth": "$date"
                }
              },
              "totalSales": {
                "$sum": "$sales"
              }
            }
          },
          {
            "$sort": {
              "_id.year": 1,
              "_id.month": 1,
              "_id.day": 1
            }
          }
        ],
        "context": {
          "date": {
            "$date": "2017-01-16T01:02:03.456Z"
          },
          "timezone": "America/Sao_Paulo"
        },
        "expected": {
          "error": "PlanExecutor error during aggregation :: caused by :: year parameter 'date' must be coercible to date"
        }
      },
