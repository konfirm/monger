{
  "operator": "$or",
  "description": "Tests for $or - Boolean expression operator that returns true when ANY expression evaluates to true",
  "mongodbVersion": "2.4",
  "implemented": true,
  "category": "Boolean Expression",
  "source": "/mongo/jstests/aggregation/expressions/not.js, /mongo/jstests/aggregation/expressions/cond.js, /mongo/jstests/aggregation/expressions/filter.js, /mongo/jstests/aggregation/expressions/collation_expressions.js, /mongo/src/mongo/db/exec/expression/evaluate_or_test.cpp",
  "implementationSource": "/mongo/src/mongo/db/exec/expression/evaluate_or_test.cpp, /mongo/src/mongo/db/pipeline/expression_or_test.cpp",
  "tests": {
    "happyPath": [
      {
        "description": "Empty array returns false",
        "query": {
          "$or": []
        },
        "context": {},
        "expected": false
      },
      {
        "description": "Single true operand returns true",
        "query": {
          "$or": [true]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Single false operand returns false",
        "query": {
          "$or": [false]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "True OR true returns true",
        "query": {
          "$or": [true, true]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "True OR false returns true (short-circuit)",
        "query": {
          "$or": [true, false]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "False OR true returns true",
        "query": {
          "$or": [false, true]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "False OR false returns false",
        "query": {
          "$or": [false, false]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "Multiple falsy values return false",
        "query": {
          "$or": [false, false, false]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "Multiple falsy with one true at end returns true",
        "query": {
          "$or": [false, false, true]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Zero OR one returns true (0 is falsy, 1 is truthy)",
        "query": {
          "$or": [0, 1]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Zero OR false returns false (both falsy)",
        "query": {
          "$or": [0, false]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "Non-zero number is truthy - returns true",
        "query": {
          "$or": [2]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Negative number is truthy - returns true",
        "query": {
          "$or": [-1]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Non-empty string is truthy - returns true",
        "query": {
          "$or": ["hello"]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Empty string is falsy - returns false",
        "query": {
          "$or": [""]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "Empty array is truthy - returns true",
        "query": {
          "$or": [[]]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Array with false value is truthy - returns true",
        "query": {
          "$or": [[false]]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Array with true value is truthy - returns true",
        "query": {
          "$or": [[true]]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Object is truthy - returns true",
        "query": {
          "$or": [{"y": 2, "z": 3}]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "ObjectId is truthy - returns true",
        "query": {
          "$or": [{"$toObjectId": "5f0627282a63fc000b8fd067"}]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Date is truthy - returns true",
        "query": {
          "$or": [{"$toDate": "2021-01-01T00:00:00Z"}]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Field path that exists evaluates to truthy - returns true",
        "query": {
          "$or": ["$field"]
        },
        "context": {
          "field": 1
        },
        "expected": true
      },
      {
        "description": "Nested $or with field paths - both true",
        "query": {
          "$or": ["$x", "$y"]
        },
        "context": {
          "x": true,
          "y": false
        },
        "expected": true
      },
      {
        "description": "Nested $or with field paths - second true",
        "query": {
          "$or": ["$x", "$y"]
        },
        "context": {
          "x": false,
          "y": true
        },
        "expected": true
      },
      {
        "description": "$or combined with $not - first operand is NOT false",
        "query": {
          "$or": [{"$not": "$x"}, "$y"]
        },
        "context": {
          "x": false,
          "y": true
        },
        "expected": true
      },
      {
        "description": "$or combined with $not - first operand is NOT true",
        "query": {
          "$or": [{"$not": "$x"}, "$y"]
        },
        "context": {
          "x": true,
          "y": false
        },
        "expected": false
      },
      {
        "description": "$or with $eq comparison - first matches",
        "query": {
          "$or": [{"$eq": ["$str", "a"]}, {"$eq": ["b", "c"]}]
        },
        "context": {
          "str": "a"
        },
        "expected": true
      },
      {
        "description": "$or with $eq comparison - second matches",
        "query": {
          "$or": [{"$eq": ["$str", "c"]}, {"$eq": ["$str2", "b"]}]
        },
        "context": {
          "str": "a",
          "str2": "b"
        },
        "expected": true
      },
      {
        "description": "$or inside $filter - filters array with complex condition",
        "query": {
          "$filter": {
            "input": "$a",
            "cond": {
              "$or": [
                {"$and": [{"$gt": ["$$this", 1]}, {"$lt": ["$$this", 3]}]},
                {"$eq": ["$$this", 5]}
              ]
            }
          }
        },
        "context": {
          "a": [1, 2, 3, 4, 5]
        },
        "expected": [2, 5]
      },
      {
        "description": "Complex nested $or in $filter with $and",
        "query": {
          "$or": [
            {
              "$and": [
                {
                  "$filter": {
                    "input": "$a",
                    "cond": {
                      "$or": [
                        {"$and": [{"$gt": ["$$this", 1]}, {"$lt": ["$$this", 3]}]},
                        {"$eq": ["$$this", 5]}
                      ]
                    }
                  }
                },
                "$d"
              ]
            },
            {"$filter": {"input": "$a", "cond": {"$eq": ["$$this", 1]}}}
          ]
        },
        "context": {
          "a": [1, 2, 3, 4, 5],
          "d": true
        },
        "expected": true
      }
    ],
    "nullCases": [
      {
        "description": "Null is falsy - single null returns false",
        "query": {
