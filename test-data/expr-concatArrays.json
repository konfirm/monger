      },
      {
        "description": "Array with valid value then missing field returns null",
        "context": {
          "int_arr": [
            1,
            2,
            3,
            4
          ]
        },
        "expected": null,
        "query": {
          "$concatArrays": [
            [
              1,
              2,
              3,
              4
            ],
            "$not_a_field"
          ]
        }
      },
      {
        "description": "Missing field before valid arrays returns null",
        "context": {
          "str_arr": [
            "a",
            "b",
            "c"
          ],
          "int_arr": [
            1,
            2,
            3,
            4
          ]
        },
        "expected": null,
        "query": {
          "$concatArrays": [
            "$not_a_field",
            [
              "a",
              "b",
              "c"
            ],
            [
              1,
              2,
              3,
              4
            ]
          ]
        }
      },
      {
        "description": "Both null field and missing field returns null",
        "context": {
          "null_val": null
        },
        "expected": null,
        "query": {
          "$concatArrays": [
            "$null_val",
            "$not_a_field"
          ]
        }
      },
      {
        "description": "Valid array before null field and non-array value returns null",
        "context": {
          "int_arr": [
            1,
            2,
            3,
            4
          ],
          "null_val": null,
          "dbl_val": 2
        },
        "expected": null,
        "query": {
          "$concatArrays": [
            [
              1,
              2,
              3,
              4
            ],
            "$null_val",
            2
          ]
        }
      },
      {
        "description": "All null fields returns null",
        "context": {
          "null_val": null
