    "nullCases": [
      {
        "description": "Single null input returns null",
        "expected": null,
        "query": {
          "$concatArrays": [
            null
          ]
        }
      },
      {
        "description": "Null field reference returns null",
        "context": {
          "null_val": null,
          "int_arr": [
            1,
            2,
            3,
            4
          ]
        },
        "expected": null,
        "query": {
          "$concatArrays": "$null_val"
        }
      },
      {
        "description": "Array with valid values followed by null returns null",
        "context": {
          "int_arr": [
            1,
            2,
            3,
            4
          ],
          "null_val": null
        },
        "expected": null,
        "query": {
          "$concatArrays": [
            [
              1,
              2,
              3,
              4
            ],
            null
          ]
        }
      },
      {
        "description": "Null followed by valid arrays returns null",
        "context": {
          "int_arr": [
            1,
            2,
            3,
            4
          ],
          "str_arr": [
            "a",
            "b",
            "c"
          ]
        },
        "expected": null,
        "query": {
          "$concatArrays": [
            null,
            [
              1,
              2,
              3,
              4
            ],
            [
              "a",
              "b",
              "c"
            ]
          ]
        }
      },
      {
        "description": "Valid array, null, then valid array returns null",
        "context": {
          "int_arr": [
            1,
            2,
            3,
            4
          ],
          "str_arr": [
            "a",
            "b",
            "c"
          ]
        },
        "expected": null,
        "query": {
          "$concatArrays": [
            [
              1,
              2,
              3,
              4
            ],
            null,
            [
              "a",
              "b",
              "c"
            ]
          ]
        }
      },
      {
        "description": "Missing field reference returns null",
        "context": {
          "int_arr": [
            1,
            2,
            3,
            4
          ]
        },
        "expected": null,
        "query": {
          "$concatArrays": "$not_a_field"
