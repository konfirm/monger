        "context": {},
        "expected": false
      },
      {
        "description": "Zero AND true returns false (0 is falsy)",
        "query": {
          "$and": [0, true]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "Empty string is falsy - returns false",
        "query": {
          "$and": [""]
