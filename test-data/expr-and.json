{
  "operator": "$and",
  "description": "Tests for $and - Boolean expression operator that returns true only when ALL expressions evaluate to true",
  "mongodbVersion": "2.4",
  "implemented": true,
  "category": "Boolean Expression",
  "source": "/mongo/jstests/aggregation/exec/value_coerce_to_bool.js, /mongo/jstests/aggregation/optimization/and_or_short_circuit.js, /mongo/jstests/aggregation/expressions/cond.js, /mongo/jstests/aggregation/expressions/not.js, /mongo/jstests/aggregation/expressions/empty_obj_arg.js, /mongo/jstests/aggregation/expressions/filter.js, /mongo/src/mongo/db/exec/expression/evaluate_and_test.cpp",
  "implementationSource": "/mongo/src/mongo/db/exec/expression/evaluate_and_test.cpp, /mongo/src/mongo/db/pipeline/expression_and_test.cpp",
  "tests": {
    "happyPath": [
      {
        "description": "Empty array returns true (vacuous truth)",
        "query": {
          "$and": []
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Single true operand returns true",
        "query": {
          "$and": [true]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Single non-zero number is truthy - returns true",
        "query": {
          "$and": [1]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "True AND true returns true",
        "query": {
          "$and": [true, true]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "True AND true AND true returns true",
        "query": {
          "$and": [true, true, true]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "All truthy values (1, 'hello', [], {}) returns true",
        "query": {
          "$and": [1, "hello", [], {}]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Field path that exists and is truthy - returns true",
        "query": {
          "$and": ["$field"]
        },
        "context": {
          "field": 1
        },
        "expected": true
      },
      {
        "description": "Multiple field paths all truthy - returns true",
        "query": {
          "$and": ["$x", "$y", "$z"]
        },
        "context": {
          "x": true,
          "y": 1,
          "z": "hello"
        },
        "expected": true
      },
      {
        "description": "$and combined with $not - NOT false AND true returns true",
        "query": {
          "$and": [{"$not": "$x"}, "$y"]
        },
        "context": {
          "x": false,
          "y": true
        },
        "expected": true
      },
      {
        "description": "$and combined with $eq comparison - both match",
        "query": {
          "$and": [{"$eq": ["$str", "a"]}, {"$eq": ["$str2", "b"]}]
        },
        "context": {
          "str": "a",
          "str2": "b"
        },
        "expected": true
      },
      {
        "description": "$and inside $cond as condition - empty $and is true",
        "query": {
          "$cond": [{"$and": []}, {"$add": [1]}, {"$add": [1, 1]}]
        },
        "context": {},
        "expected": 1
      },
      {
        "description": "Empty object {} is truthy - returns true",
        "query": {
          "$and": [{}]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Empty array [] is truthy - returns true",
        "query": {
          "$and": [[]]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Array with values is truthy - returns true",
        "query": {
          "$and": [[1, 2, 3]]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Array with false value is truthy - returns true",
        "query": {
          "$and": [[false]]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Negative number is truthy - returns true",
        "query": {
          "$and": [-1]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "Object with fields is truthy - returns true",
        "query": {
          "$and": [{"y": 2, "z": 3}]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "$and used in $filter - both conditions satisfied",
        "query": {
          "$filter": {
            "input": "$a",
            "cond": {
              "$and": [
                {"$gt": ["$$this", 1]},
                {"$lt": ["$$this", 4]}
              ]
            }
          }
        },
        "context": {
          "a": [1, 2, 3, 4, 5]
        },
        "expected": [2, 3]
      },
      {
        "description": "Complex nested $and with $or",
        "query": {
          "$and": [
            {"$or": [true, false]},
            {"$and": [true, true]}
          ]
        },
        "context": {},
        "expected": true
      },
      {
        "description": "$and with multiple nested comparisons - all true",
        "query": {
          "$and": [
            {"$eq": ["$x", 1]},
            {"$gt": ["$y", 0]},
            {"$lt": ["$z", 10]}
          ]
        },
        "context": {
          "x": 1,
          "y": 5,
          "z": 8
        },
        "expected": true
      }
    ],
    "nullCases": [
      {
        "description": "Null is falsy - single null returns false",
        "query": {
          "$and": [null]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "Undefined/missing field is falsy - returns false",
        "query": {
          "$and": ["$missingField"]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "True AND null returns false",
        "query": {
          "$and": [true, null]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "Null AND true returns false",
        "query": {
          "$and": [null, true]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "Null AND null returns false",
        "query": {
          "$and": [null, null]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "Field path evaluating to null is falsy",
        "query": {
          "$and": ["$field"]
        },
        "context": {
          "field": null
        },
        "expected": false
      },
      {
        "description": "Multiple truthy values with one null returns false",
        "query": {
          "$and": [1, true, "hello", null]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "$and inside $cond with null - first arg null evaluates to false",
        "query": {
          "$cond": [{"$and": [null]}, {"$add": [1]}, {"$add": [1, 1]}]
        },
        "context": {},
        "expected": 2
      }
    ],
    "errors": [
      {
        "description": "Non-array input (string) throws error",
        "query": {
          "$and": "string"
        },
        "errorExpected": true
      },
      {
        "description": "Non-array input (object) throws error",
        "query": {
          "$and": {"key": "value"}
        },
        "errorExpected": true
      },
      {
        "description": "Non-array input (number) throws error",
        "query": {
          "$and": 123
        },
        "errorExpected": true
      },
      {
        "description": "Non-array input (boolean) throws error",
        "query": {
          "$and": true
        },
        "errorExpected": true
      },
      {
        "description": "Non-array input (null) throws error",
        "query": {
          "$and": null
        },
        "errorExpected": true
      }
    ],
    "edgeCases": [
      {
        "description": "Single false operand returns false",
        "query": {
          "$and": [false]
