        "context": {},
        "expected": false
      },
      {
        "description": "True AND false returns false",
        "query": {
          "$and": [true, false]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "False AND true returns false",
        "query": {
          "$and": [false, true]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "False AND false returns false",
        "query": {
          "$and": [false, false]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "Zero is falsy - returns false",
        "query": {
          "$and": [0]
        },
        "context": {},
        "expected": false
      },
      {
        "description": "True AND 0 returns false (0 is falsy)",
        "query": {
