{
  "operator": "$concatArrays",
  "description": "Concatenates arrays together, returns null if any input is null/missing, throws error 28664 for non-array inputs",
  "mongodbVersion": "3.2",
  "source": "mongo/jstests/aggregation/expressions/concat_arrays.js",
  "implementationSource": "mongo/src/mongo/db/exec/expression/evaluate_array.cpp",
  "tests": {
    "happyPath": [
      {
        "description": "Single array returns the array",
        "context": {
          "int_arr": [
            1,
            2,
            3,
            4
          ]
        },
        "expected": [
          1,
          2,
          3,
          4
        ],
        "query": {
          "$concatArrays": [
            [
              1,
              2,
              3,
              4
            ]
          ]
        }
      },
      {
        "description": "Concatenate two arrays",
        "context": {
          "int_arr": [
            1,
            2,
            3,
            4
          ],
          "str_arr": [
            "a",
            "b",
            "c"
          ]
        },
        "expected": [
          1,
          2,
          3,
          4,
          "a",
          "b",
          "c"
        ],
        "query": {
          "$concatArrays": [
            [
              1,
              2,
              3,
              4
            ],
            [
              "a",
              "b",
              "c"
            ]
          ]
        }
      },
      {
        "description": "Concatenate multiple arrays - numbers and strings",
        "context": {
          "int_arr": [
            1,
            2,
            3,
            4
          ],
          "str_arr": [
            "a",
            "b",
            "c"
          ],
          "nested_arr": [
            [
              "an",
              "array"
            ],
            "arr",
            [
              [],
              [
                [],
                "a",
                "b"
              ]
            ]
          ]
        },
        "expected": [
          1,
          2,
          3,
          4,
          "a",
          "b",
          "c",
          [
            "an",
            "array"
          ],
          "arr",
          [
            [],
            [
              [],
              "a",
              "b"
            ]
          ]
        ],
        "query": {
          "$concatArrays": [
            [
              1,
              2,
              3,
              4
            ],
            [
              "a",
              "b",
              "c"
            ],
            [
              [
                "an",
                "array"
              ],
              "arr",
              [
                [],
                [
                  [],
                  "a",
                  "b"
                ]
              ]
            ]
          ]
        }
      },
      {
        "description": "Concatenate object arrays",
        "context": {
          "obj_arr": [
            {
              "a": 1,
              "b": 2
            },
            {
              "c": 3
            },
            {
              "d": 4,
              "e": 5
