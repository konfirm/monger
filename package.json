{
	"name": "@konfirm/monger",
	"version": "1.0.0",
	"description": "",
	"main": "dist/cjs/main.js",
	"module": "dist/esm/main.js",
	"iife": "dist/main.js",
	"types": "dist/main.d.ts",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "node --require ts-node/register scripts/test.ts",
		"test:full": "node --require ts-node/register scripts/test.ts done doing hold planned",
		"test:coverage": "nyc --reporter=html node --require ts-node/register scripts/test.ts done doing hold planned",
		"test:legacy": "ts-node node_modules/tape/bin/tape 'test/**/*.ts'",
		"prebuild": "tsc --declarationDir temp --declaration true --emitDeclarationOnly true",
		"build": "rollup -c rollup.config.mjs",
		"postbuild": "rm -rf temp",
		"prepublish": "npm run build",
		"work": "nyc --require ts-node/register tape 'test/**/Expression/Compatibility.ts' | tap-arc",
		"catalog:fetch": "ts-node scripts/fetch-catalog-release.ts"
	},
	"keywords": [
		"mongo",
		"mongodb",
		"query"
	],
	"files": [
		"source/*",
		"dist/*",
		"!**/*.spec.ts",
		"!source/Test/**"
	],
	"author": "Rogier Spieker <rogier+npm@konfirm.eu>",
	"license": "MIT",
	"devDependencies": {
		"@rollup/plugin-commonjs": "^24.0.1",
		"@rollup/plugin-node-resolve": "^15.0.1",
		"@rollup/plugin-terser": "^0.4.0",
		"@rollup/plugin-typescript": "^11.0.0",
		"@types/tape": "^4.13.2",
		"nyc": "^15.1.0",
		"rollup": "^3.14.0",
		"rollup-plugin-dts": "^5.1.1",
		"tap-arc": "^0.3.5",
		"tape": "^5.6.3",
		"template-literal-each": "^3.0.0",
		"ts-node": "^10.9.1",
		"tslib": "^2.5.0",
		"typescript": "^4.9.5"
	},
	"dependencies": {
		"@konfirm/geojson": "file:../../github/konfirm/geojson",
		"@konfirm/guard": "^2.0.2",
		"mongodb": "^7.0.0"
	}
}
